views {
  // `index` is rendered by default and is what the README embeds.
  view index {
    title 'Landscape'
    include *
    include
      operator -> yasshm with {
        title 'configures and audits on the host'
      }
    autoLayout LeftRight
  }

  view yasshm of yasshm {
    title 'Inside yasshm'
    include *
  }
}
